# ITR — serviço de e-mail/WhatsApp
# Copie para .env apenas no ambiente local. Nunca versione segredos reais.

PORT=3000
APP_TIMEZONE=America/Sao_Paulo
CRON_ATIVO=true
CRON_HORARIO=0 8 * * *

# Airtable
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_ID=
AIRTABLE_OS_TABLE_ID=
AIRTABLE_VIEW_ID=

# SMTP
EMAIL_ATIVO=true
EMAIL_REMETENTE=ITR Engenharia <naoresponda@itr.eng.br>
EMAIL_MODO_TESTE=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# WhatsApp Cloud API
WHATSAPP_ATIVO=false
WHATSAPP_SIMULAR=true
WHATSAPP_MODO_TESTE=true
WHATSAPP_TEST_NUMBER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v25.0
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_TEMPLATE_PARAMETER_MODE=named
# Pode incluir cnpj e senha_inicial no template diário aprovado pela Meta.
WHATSAPP_TEMPLATE_BODY_PARAMETERS=ordem_servico,detalhes
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_VALIDAR_ASSINATURA=true
META_APP_SECRET=

# Portal público
PORTAL_CLIENTE_URL=https://portal.itr.eng.br/login.html
PORTAL_ORIGIN=https://portal.itr.eng.br

# NOVO 3.1 — canal interno Portal -> notificações.
# O mesmo valor Base64 de 32+ bytes deve ser configurado no Portal como
# PORTAL_NOTIFICATIONS_HMAC_SECRET. Gere localmente com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PORTAL_INTERNAL_HMAC_SECRET=
PORTAL_INTERNAL_MAX_SKEW_SECONDS=300

# Alertas de segurança por WhatsApp são opcionais e NÃO recebem link de reset.
PORTAL_SECURITY_WHATSAPP_ENABLED=false
WHATSAPP_SECURITY_TEMPLATE_NAME=
WHATSAPP_SECURITY_TEMPLATE_LANGUAGE=pt_BR

# Disparo manual atual — NÃO reutilize como segredo do Portal.
CHAVE_DISPARO_MANUAL=
PERMITIR_DISPARO_MANUAL_GET=false
