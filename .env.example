# ============================================================
# ITR NOTIFICAÇÕES 2.1.1 — CONFIGURAÇÃO COMPLETA
# ============================================================
# Copie para .env apenas no ambiente local.
# Nunca versione .env, tokens, senhas ou dumps.
# Rode `npm run preflight` antes de iniciar.

NODE_ENV=production
PORT=3000
APP_TIMEZONE=America/Sao_Paulo

# Automação diária
CRON_ATIVO=true
CRON_HORARIO=0 8 * * *
# OBRIGATÓRIO com CRON_ATIVO=true. Use ISO-8601 com fuso explícito.
# Exemplo: 2026-08-01T00:00:00-03:00
AUTOMACAO_INICIO_EM=

# Servidor HTTP
SERVIDOR_JSON_LIMITE=32kb
SERVIDOR_KEEP_ALIVE_TIMEOUT_MS=65000
SERVIDOR_KEEP_ALIVE_BUFFER_MS=5000
SERVIDOR_HEADERS_TIMEOUT_MS=75000
SERVIDOR_REQUEST_TIMEOUT_MS=900000

# ============================================================
# AIRTABLE
# ============================================================
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_ID=
AIRTABLE_OS_TABLE_ID=
AIRTABLE_VIEW_ID=
AIRTABLE_FILTER_FORMULA=

AIRTABLE_TIMEOUT_MS=20000
AIRTABLE_MAX_TENTATIVAS=3
AIRTABLE_PAGE_SIZE=100
AIRTABLE_MAX_PAGINAS=1000
AIRTABLE_WHATSAPP_COUNTRY_CODE=55
AIRTABLE_CONTATOS_USAR_TODOS_REGISTROS=true
AIRTABLE_BLOQUEAR_WHATSAPP_COMPARTILHADO=true
AIRTABLE_LOG_DADOS_INVALIDOS=true
AIRTABLE_LOG_REGISTROS_IGNORADOS=true
AIRTABLE_STATUS_PERMITIDOS=Aguardando Preparação|Enviado ao Cliente

# Nomes dos campos. Só altere se o Airtable mudar.
AIRTABLE_CAMPO_CLIENTE_LINK=Cliente
AIRTABLE_CAMPO_OS_LINK=Ordem de Serviço
AIRTABLE_CAMPO_CLIENTE_TEXTO=Cliente Texto
AIRTABLE_CAMPO_OS_TEXTO=OS Texto
AIRTABLE_CAMPO_EMAIL_CLIENTE=Email do Cliente
AIRTABLE_CAMPO_CNPJ_CLIENTE=CNPJ do Cliente
AIRTABLE_CAMPO_WHATSAPP_CLIENTE=WhatsApp do Cliente
AIRTABLE_CAMPO_ID_TRABALHO=ID Trabalho
AIRTABLE_CAMPO_NOME_TRABALHO=Nome Trabalho
AIRTABLE_CAMPO_AMOSTRA=Link Amostras
AIRTABLE_CAMPO_ENSAIO_SIGLA=Link Ensaios
# Há um espaço final real no nome padrão atual; mantenha as aspas.
AIRTABLE_CAMPO_ENSAIO_NOME="Nome_Completo_Ensaios "
AIRTABLE_CAMPO_STATUS_CLIENTE=Status Cliente
AIRTABLE_CAMPO_STATUS=Status
AIRTABLE_CAMPO_DATA_CONCLUSAO=Data de Conclusão do Ensaio
AIRTABLE_CAMPO_DATA_ENVIO_RELATORIO=Data de Envio do Relatório
AIRTABLE_CAMPO_DATA_ATUALIZACAO=Data da Última Atualização Update

# Idempotência persistente no Airtable.
# Ative apenas depois de confirmar que os campos abaixo existem na tabela de OS.
IDEMPOTENCIA_ATIVA=false
IDEMPOTENCIA_FALHAR_FECHADO=true
IDEMPOTENCIA_RESERVA_TTL_MINUTOS=30
AIRTABLE_CAMPO_IDEMPOTENCIA_EMAIL_ESTADO=Automação Email - Estado
AIRTABLE_CAMPO_IDEMPOTENCIA_EMAIL_HASH=Automação Email - Hash
AIRTABLE_CAMPO_IDEMPOTENCIA_EMAIL_ATUALIZADO_EM=Automação Email - Atualizado Em
AIRTABLE_CAMPO_IDEMPOTENCIA_WHATSAPP_ESTADO=Automação WhatsApp - Estado
AIRTABLE_CAMPO_IDEMPOTENCIA_WHATSAPP_HASH=Automação WhatsApp - Hash
AIRTABLE_CAMPO_IDEMPOTENCIA_WHATSAPP_ATUALIZADO_EM=Automação WhatsApp - Atualizado Em

# ============================================================
# E-MAIL / SMTP
# ============================================================
# EMAIL_ATIVO controla o fluxo DIÁRIO. As notificações de segurança do Portal
# usam o SMTP diretamente quando recebidas pelo endpoint interno.
EMAIL_ATIVO=true
EMAIL_REMETENTE=ITR Engenharia <naoresponda@itr.eng.br>
# VAZIO = destinatários reais. Para teste, use UM e-mail válido.
# NÃO use false, true, 0 ou 1.
EMAIL_MODO_TESTE=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_PAUSA_MS=1500

# ============================================================
# WHATSAPP CLOUD API
# ============================================================
WHATSAPP_ATIVO=false
WHATSAPP_SIMULAR=true
WHATSAPP_MODO_TESTE=true
WHATSAPP_TEST_NUMBER=
WHATSAPP_COUNTRY_CODE=55
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v25.0
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
WHATSAPP_TIMEOUT_MS=20000
WHATSAPP_MAX_TENTATIVAS=1
WHATSAPP_RETRY_BASE_MS=1500
WHATSAPP_LOG_PAYLOAD=false
WHATSAPP_NUMEROS_BLOQUEADOS=
WHATSAPP_PAUSA_MS=1200
WHATSAPP_EXIGIR_EMAIL_ENVIADO=true
PAUSA_ENTRE_OS_MS=0

# Template diário
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_TEMPLATE_PARAMETER_MODE=named
WHATSAPP_TEMPLATE_BODY_PARAMETERS=ordem_servico,detalhes
WHATSAPP_FORMATO_DETALHES=auto
WHATSAPP_DETALHES_MAX_CHARS=800
WHATSAPP_TEMPLATE_BODY_MAX_CHARS=1024
WHATSAPP_TEMPLATE_BODY_FIXED_CHARS=306
WHATSAPP_TEMPLATE_BODY_SAFETY_MARGIN=20
WHATSAPP_TEMPLATE_HEADER_TYPE=none
WHATSAPP_TEMPLATE_HEADER_TEXT_SOURCE=
WHATSAPP_TEMPLATE_HEADER_TEXT_PARAMETER_NAME=
WHATSAPP_TEMPLATE_HEADER_MEDIA_ID=
WHATSAPP_TEMPLATE_HEADER_MEDIA_URL=
WHATSAPP_TEMPLATE_HEADER_DOCUMENT_FILENAME=
WHATSAPP_TEMPLATE_BUTTONS=

# Webhook Meta
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_VALIDAR_ASSINATURA=true
WHATSAPP_WEBHOOK_JSON_LIMITE=3mb
META_APP_SECRET=

# ============================================================
# PORTAL ITR 3.1+
# ============================================================
PORTAL_CLIENTE_URL=https://portal.itr.eng.br/login.html
PORTAL_ORIGIN=https://portal.itr.eng.br

# Mesmo segredo Base64 de 32+ bytes usado no Portal em
# PORTAL_NOTIFICATIONS_HMAC_SECRET.
PORTAL_INTERNAL_HMAC_SECRET=
PORTAL_INTERNAL_MAX_SKEW_SECONDS=300

# WhatsApp de segurança é opcional e NUNCA recebe token/link de reset.
# Quando WHATSAPP_MODO_TESTE=true, também usa WHATSAPP_TEST_NUMBER.
PORTAL_SECURITY_WHATSAPP_ENABLED=false
WHATSAPP_SECURITY_TEMPLATE_NAME=
WHATSAPP_SECURITY_TEMPLATE_LANGUAGE=pt_BR

# ============================================================
# ADMINISTRAÇÃO
# ============================================================
# Use uma chave aleatória forte. /status e /disparar-agora aceitam somente
# X-API-Key ou Authorization: Bearer. Segredos em query string são recusados.
CHAVE_DISPARO_MANUAL=
PERMITIR_DISPARO_MANUAL_GET=false

# Somente para o teste explícito validar:whatsapp:producao.
# Mantidos fora do código para não publicar metadados internos desnecessários.
WHATSAPP_EXPECTED_WABA_ID=
WHATSAPP_EXPECTED_PHONE_NUMBER_ID=
